---
import CinematicScene from '../components/CinematicScene.astro';
import OpenSourceShield from '../components/OpenSourceShield.astro';
import ProductDock from '../components/ProductDock.astro';
import OrbitalScene from '../components/orbit/OrbitalScene.astro';
import { featuredRepositories, pages } from '../data';
import { defaultCatalogue } from '../i18n';
import SiteLayout from '../layouts/SiteLayout.astro';

const copy = defaultCatalogue.pages.home;
const { homeExperience, repositoryStages, repositories } = defaultCatalogue;
const [firstSection, extensionSection, openSection] = copy.sections;
const productIcons = ['core', 'studio', 'extension', 'clients'] as const;
const productItems = homeExperience.products.map((product, index) => ({
  ...product,
  icon: productIcons[index] ?? 'core',
}));
---

<SiteLayout title={copy.metaTitle} description={copy.metaDescription}>
  <section class="home-hero" aria-labelledby="home-title" data-home-hero>
    <div class="home-hero__scanline" aria-hidden="true"></div>
    <div class="container home-hero__inner">
      <div class="home-hero__stage">
        <div class="home-hero__copy">
          <span class="home-eyebrow">{copy.hero.eyebrow}</span>
          <h1 class="home-title" id="home-title">
            {
              copy.hero.titleLines?.map((line, index) => (
                <span class="home-title__line" data-home-title-line>
                  {line}
                  {index < copy.hero.titleLines!.length - 1 ? ' ' : ''}
                </span>
              ))
            }
          </h1>
          <p class="home-summary">{copy.hero.summary}</p>
          <div class="hero-actions home-actions">
            <a class="button button-primary" href={pages.home.primaryActionHref}>
              {copy.hero.primaryAction.label}
              <span class="button-arrow" aria-hidden="true">→</span>
            </a>
            <a
              class="button button-secondary button-github"
              href={pages.home.secondaryActionHref}
              target="_blank"
              rel="noreferrer"
              aria-label={copy.hero.secondaryAction.accessibleLabel}
            >
              {copy.hero.secondaryAction.label}
              <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.86c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.52 2.33 1.08 2.9.83.09-.64.35-1.08.63-1.33-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.6 9.6 0 0 1 12 6.84a9.6 9.6 0 0 1 2.5.34c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"
                ></path>
              </svg>
            </a>
          </div>
          <OpenSourceShield class="home-trust" label={homeExperience.trustLine} />
        </div>

        <div class="home-hero__orbit" data-home-orbital-viewport>
          <OrbitalScene quality="high">
            <div class="namibia-readout" data-location-readout aria-hidden="true">
              <span class="namibia-readout__signal"></span>
              <span>17°23′59″ S · 18°25′00″ E</span>
              <strong>KATWITWI · ORIGIN</strong>
            </div>
          </OrbitalScene>
        </div>
      </div>

      <ProductDock
        class="home-product-dock"
        heading={homeExperience.ecosystemTitle}
        items={productItems}
      />
    </div>
  </section>

  <section class="home-mission-section home-core-section" aria-labelledby="home-core-title">
    <div class="container home-mission-grid">
      <div class="home-section-copy">
        <span class="section-kicker">{firstSection.eyebrow}</span>
        <h2 id="home-core-title">{firstSection.title}</h2>
        <p class="section-lead">{firstSection.body}</p>
        <div class="home-principles" data-visual-story>
          {
            firstSection.items?.map((item, index) => (
              <article>
                <span class="mission-index">0{index + 1}</span>
                <div>
                  <span class="section-kicker">{item.eyebrow}</span>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
      <CinematicScene
        class="home-core-visual"
        src="/images/mascot/home/home-connected-design.webp"
        alt="The Kumwe meerkat engineer connecting content, business operations and delivery services from one command core."
        variant="section"
      />
    </div>
  </section>

  <section
    class="home-mission-section home-extension-section"
    aria-labelledby="home-contract-title"
  >
    <div class="container home-mission-grid home-mission-grid--reverse">
      <div class="home-visual-bay" data-visual-story>
        <CinematicScene
          src="/images/mascot/home/home-extensible-workshop.webp"
          alt="The Kumwe meerkat installing an advanced capability module while the protected platform core remains intact."
          variant="section"
        />
        <div class="visual-bay__legend" aria-hidden="true">
          <span>01 · INSPECT</span><span>02 · VERIFY</span><span>03 · ACTIVATE</span>
        </div>
      </div>
      <div class="home-section-copy">
        <span class="section-kicker">{extensionSection.eyebrow}</span>
        <h2 id="home-contract-title">{extensionSection.title}</h2>
        <p class="section-lead">{extensionSection.body}</p>
        {extensionSection.note && <p class="mission-note">{extensionSection.note}</p>}
        <div class="section-actions">
          <a class="button button-primary" href="/extensions/">
            Explore extensions <span aria-hidden="true">→</span>
          </a>
          <a class="button button-secondary" href="/packages/">Browse packages</a>
        </div>
      </div>
    </div>
  </section>

  <section class="home-mission-section home-open-section" aria-labelledby="home-open-title">
    <div class="container">
      <div class="mission-section-heading">
        <div>
          <span class="section-kicker">{openSection.eyebrow}</span>
          <h2 id="home-open-title">{openSection.title}</h2>
        </div>
        <p>{openSection.body}</p>
      </div>
      <CinematicScene
        class="home-evidence-visual"
        src="/images/mascot/home/home-public-evidence.webp"
        alt="The Kumwe meerkat inspecting public engineering evidence and work at different levels of maturity."
        variant="wide"
      />
      <div class="repository-constellation" data-visual-story>
        <span class="repository-constellation__orbit" aria-hidden="true"></span>
        {
          featuredRepositories.slice(0, 6).map((repository, index) => (
            <a
              class="repository-pod"
              href={repository.url}
              target="_blank"
              rel="noreferrer"
              style={`--pod-index:${index}`}
            >
              <span class="repository-pod__signal" aria-hidden="true" />
              <span class="repository-pod__code">NODE · 0{index + 1}</span>
              <strong>{repository.name}</strong>
              <span>
                {repositoryStages[repository.stage]} · {repositories[repository.id].title}
              </span>
              <i aria-hidden="true">↗</i>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {
    copy.closing && (
      <section class="container mission-closing" aria-labelledby="home-closing">
        <CinematicScene
          class="mission-closing__art"
          src="/images/mascot/home/home-working-platform-cta.webp"
          alt="The Kumwe meerkat piloting an operational spacecraft toward its destination."
          objectPosition="64% 50%"
          variant="cta"
        />
        <div class="mission-closing__copy">
          <span class="section-kicker">MISSION READY</span>
          <h2 id="home-closing">{copy.closing.title}</h2>
          <p>{copy.closing.body}</p>
        </div>
        <a
          class="button button-primary"
          href={pages.home.secondaryActionHref}
          target="_blank"
          rel="noreferrer"
        >
          {copy.closing.action.label}
          <span aria-hidden="true">↗</span>
        </a>
      </section>
    )
  }
</SiteLayout>
