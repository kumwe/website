        </g>
      )
    }

    {
      pageId === 'packages' && (
        <g class="mission-packages">
          <g class="mission-visual__rotate mission-visual__rotate--slow">
            <circle
              class="mission-visual__orbit mission-visual__orbit--dashed"
              cx="340"
              cy="241"
              r="179"
            />
            <circle class="mission-visual__node" cx="340" cy="62" r="7" />
            <circle class="mission-visual__node" cx="495" cy="151" r="7" />
            <circle class="mission-visual__node" cx="495" cy="331" r="7" />
            <circle class="mission-visual__node" cx="340" cy="420" r="7" />
            <circle class="mission-visual__node" cx="185" cy="331" r="7" />
            <circle class="mission-visual__node" cx="185" cy="151" r="7" />
          </g>
          <ellipse class="mission-visual__orbit" cx="340" cy="241" rx="268" ry="91" />
