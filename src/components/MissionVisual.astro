          </g>
          <path
            class="mission-visual__stream"
            d="M143 153 244 202M537 153 436 202M108 271l126-16M572 271l-126-16M211 370l69-74M469 370l-69-74M340 94v82"
          />
          <g class="mission-visual__float">
            <path class="mission-visual__core-shell" d="m340 157 88 49v87l-88 49-88-49v-87Z" />
            <path class="mission-platform__split" d="M340 158v184" />
            <circle
              class="mission-platform__half mission-platform__half--left"
              cx="311"
              cy="249"
              r="46"
            />
            <circle
              class="mission-platform__half mission-platform__half--right"
              cx="369"
              cy="249"
              r="46"
            />
            <path
              class="mission-visual__accent"
              d="m300 248 11-11 11 11-11 11Zm58 0 11-11 11 11-11 11Z"
            />
            <circle class="mission-visual__pulse" cx="340" cy="249" r="10" />
          </g>
          <g class="mission-platform__surface-glyphs">
            <path d="M326 74h28M326 82h18" />
            <path d="m550 140 16 9-16 9" />
            <rect x="559" y="259" width="25" height="18" rx="3" />
            <path d="M457 390h26M470 377v26" />
            <path d="M197 383h28v18h-28zM204 377v6M218 377v6" />
            <path d="m95 258-12 13 12 13M120 258l12 13-12 13" />
            <circle cx="126" cy="148" r="12" />
