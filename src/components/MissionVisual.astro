          </g>
          <circle class="mission-roadmap__signal" cx="316" cy="331" r="5" />
          <circle class="mission-roadmap__signal" cx="306" cy="208" r="5" />
        </g>
      )
    }

    {
      pageId === 'open-source' && (
        <g class="mission-open-source">
          <g class="mission-visual__rotate mission-visual__rotate--reverse">
            <circle class="mission-open-source__boundary" cx="340" cy="240" r="188" />
            <circle class="mission-visual__node" cx="340" cy="52" r="7" />
            <circle class="mission-visual__node" cx="503" cy="146" r="7" />
            <circle class="mission-visual__node" cx="503" cy="334" r="7" />
            <circle class="mission-visual__node" cx="340" cy="428" r="7" />
            <circle class="mission-visual__node" cx="177" cy="334" r="7" />
            <circle class="mission-visual__node" cx="177" cy="146" r="7" />
          </g>
          <g class="mission-open-source__rays">
            <path d="M340 87v69M473 164l-70 54M473 316l-70-54M340 393v-69M207 316l70-54M207 164l70 54" />
          </g>
          <g class="mission-open-source__aperture mission-visual__rotate mission-visual__rotate--slow">
            <path d="M340 118a122 122 0 0 1 106 61l-61 35a52 52 0 0 0-45-26Z" />
            <path d="M446 179a122 122 0 0 1 0 122l-61-35a52 52 0 0 0 0-52Z" />
            <path d="M446 301a122 122 0 0 1-106 61v-70a52 52 0 0 0 45-26Z" />
            <path d="M340 362a122 122 0 0 1-106-61l61-35a52 52 0 0 0 45 26Z" />
            <path d="M234 301a122 122 0 0 1 0-122l61 35a52 52 0 0 0 0 52Z" />
            <path d="M234 179a122 122 0 0 1 106-61v70a52 52 0 0 0-45 26Z" />
          </g>
          <g class="mission-open-source__shield mission-visual__float">
            <path
              class="mission-visual__core-shell"
              d="M340 176c24 17 51 21 71 22v51c0 40-27 67-71 87-44-20-71-47-71-87v-51c20-1 47-5 71-22Z"
            />
            <path
              class="mission-open-source__open"
              d="M326 231c-20 0-31 13-31 29s11 29 31 29M354 231c20 0 31 13 31 29s-11 29-31 29"
            />
