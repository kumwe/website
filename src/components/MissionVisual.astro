              cx="455"
              cy="138"
              r="6"
            />
            <path class="mission-extensions__check" d="m441 243 10 10 19-22" />
          </g>
          <g class="mission-extensions__dock">
            <circle cx="563" cy="243" r="69" />
            <circle
              class="mission-visual__orbit mission-visual__orbit--dashed mission-visual__rotate"
              cx="563"
              cy="243"
              r="52"
            />
            <path class="mission-visual__core-shell" d="m563 202 36 20v42l-36 20-36-20v-42Z" />
            <circle class="mission-visual__pulse" cx="563" cy="243" r="12" />
          </g>
          <path class="mission-extensions__telemetry" d="M246 381h46M339 400h46M432 381h46" />
        </g>
