        </g>
      )
    }
  </svg>
</div>

<style>
  .mission-visual {
    --mission-accent-a: #50d8ff;
    --mission-accent-b: #30d9c6;
    --mission-panel-high: rgb(10 30 53 / 86%);
    --mission-panel-low: rgb(3 13 28 / 52%);
    --mission-line: rgb(111 207 238 / 23%);
    --mission-line-strong: rgb(91 221 255 / 57%);
    --mission-ink: #dff8ff;
    --mission-muted: rgb(177 219 233 / 48%);
    aspect-ratio: 17 / 12;
    contain: layout paint style;
    display: block;
    isolation: isolate;
    min-height: 17rem;
    overflow: hidden;
    pointer-events: none;
    position: relative;
    user-select: none;
    width: 100%;
  }

  .mission-visual[data-mission='studio'] {
    --mission-accent-a: #4fdcff;
    --mission-accent-b: #9a79ff;
  }

  .mission-visual[data-mission='extensions'] {
    --mission-accent-a: #52e5d0;
    --mission-accent-b: #5dbdff;
  }

  .mission-visual[data-mission='clients'] {
    --mission-accent-a: #5bcfff;
    --mission-accent-b: #7f8fff;
  }

  .mission-visual[data-mission='packages'] {
    --mission-accent-a: #45e2dc;
    --mission-accent-b: #54a9ff;
  }

  .mission-visual[data-mission='roadmap'] {
    --mission-accent-a: #59ddff;
    --mission-accent-b: #ffbf65;
  }

  .mission-visual[data-mission='open-source'] {
    --mission-accent-a: #42e3d0;
    --mission-accent-b: #52c7ff;
  }

  .mission-visual::before {
    background:
      radial-gradient(
        circle at 68% 28%,
        color-mix(in srgb, var(--mission-accent-a), transparent 78%),
        transparent 33%
      ),
      radial-gradient(
        circle at 24% 72%,
        color-mix(in srgb, var(--mission-accent-b), transparent 86%),
        transparent 36%
      );
    content: '';
    inset: 0;
    position: absolute;
  }

  .mission-visual svg {
    display: block;
    height: 100%;
    overflow: visible;
    position: relative;
    width: 100%;
  }

  .mission-visual__panel {
    fill: var(--mission-panel-high);
    fill-opacity: 0.78;
    stroke: var(--mission-line);
    stroke-width: 1.2;
  }

  .mission-visual__corner {
    fill: none;
    stroke: var(--mission-line-strong);
    stroke-linecap: round;
    stroke-width: 1.5;
  }

  .mission-visual__grid {
    fill: none;
    opacity: 0.24;
    stroke: var(--mission-line);
    stroke-width: 0.8;
  }

  .mission-visual__orbit,
  .mission-visual__stream,
  .mission-visual__core-shell {
    fill: none;
    stroke: var(--mission-line-strong);
    stroke-width: 1.5;
  }

  .mission-visual__orbit--dashed {
    stroke-dasharray: 5 12;
  }

  .mission-visual__stream {
    animation: mission-flow 8s linear infinite;
    stroke-dasharray: 4 10;
  }

  .mission-visual__core-shell {
    fill: var(--mission-accent-a);
    fill-opacity: 0.11;
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--mission-accent-a), transparent 45%));
  }

  .mission-visual__accent {
    fill: none;
    stroke: var(--mission-accent-a);
    stroke-width: 2;
  }

  .mission-visual__node {
    fill: var(--mission-panel-high);
    stroke: var(--mission-line-strong);
    stroke-width: 2;
  }

  .mission-visual__node--hot,
  .mission-visual__pulse {
    fill: var(--mission-accent-a);
    filter: drop-shadow(0 0 5px color-mix(in srgb, var(--mission-accent-a), transparent 30%));
  }

  .mission-visual__pulse {
    animation: mission-pulse 3.2s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  .mission-visual__rotate {
    animation: mission-rotate 22s linear infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  .mission-visual__rotate--slow {
    animation-duration: 34s;
  }

  .mission-visual__rotate--reverse {
    animation-direction: reverse;
    animation-duration: 31s;
  }

  .mission-visual__float {
    animation: mission-float 7s ease-in-out infinite;
  }

  .mission-platform__split,
  .mission-platform__surface-glyphs,
  .mission-studio__bar,
  .mission-studio__tool,
  .mission-studio__canvas,
  .mission-studio__inspector,
  .mission-extensions__telemetry,
  .mission-clients__device,
  .mission-clients__satellite,
  .mission-packages__bay,
  .mission-packages__pods,
  .mission-roadmap__ticks,
  .mission-open-source__rays,
  .mission-open-source__licence {
    fill: none;
    stroke: var(--mission-muted);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  .mission-platform__half {
    fill: color-mix(in srgb, var(--mission-accent-a), transparent 88%);
    stroke: var(--mission-accent-a);
    stroke-opacity: 0.48;
  }

  .mission-platform__half--right {
    fill: color-mix(in srgb, var(--mission-accent-b), transparent 88%);
    stroke: var(--mission-accent-b);
  }

  .mission-studio__window,
  .mission-studio__canvas rect,
  .mission-studio__inspector rect,
  .mission-clients__device rect,
  .mission-clients__device path:first-child,
  .mission-packages__pods rect,
  .mission-open-source__licence rect {
    fill: color-mix(in srgb, var(--mission-panel-high), transparent 8%);
    stroke: var(--mission-line-strong);
    stroke-width: 1.2;
  }

  .mission-studio__control,
  .mission-studio__handle {
    fill: var(--mission-accent-a);
  }

  .mission-studio__selected {
    fill: color-mix(in srgb, var(--mission-accent-b), transparent 91%) !important;
    stroke: var(--mission-accent-b) !important;
    stroke-dasharray: 6 5;
