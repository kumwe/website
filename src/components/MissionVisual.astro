            <rect x="172" y="207" width="132" height="80" rx="8" />
            <rect x="318" y="207" width="132" height="80" rx="8" />
            <rect class="mission-studio__selected" x="172" y="304" width="278" height="76" rx="8" />
            <circle class="mission-studio__handle" cx="172" cy="304" r="4" />
            <circle class="mission-studio__handle" cx="450" cy="304" r="4" />
            <circle class="mission-studio__handle" cx="172" cy="380" r="4" />
            <circle class="mission-studio__handle" cx="450" cy="380" r="4" />
            <path d="M193 160h137M193 171h88M193 230h78M193 245h52M339 229h83M339 244h59M193 326h211M193 342h178M193 358h126" />
