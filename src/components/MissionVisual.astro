          <g class="mission-packages__bay mission-packages__bay--one mission-visual__float">
            <path d="m135 190 55 31v62l-55 31-55-31v-62Z" />
            <path d="M103 237h64M103 253h64M135 207v90" />
            <circle class="mission-visual__pulse" cx="135" cy="252" r="8" />
          </g>
          <g class="mission-packages__bay mission-packages__bay--two mission-visual__float">
            <path class="mission-visual__core-shell" d="m340 164 68 39v77l-68 39-68-39v-77Z" />
            <path d="m309 211 31-18 31 18v36l-31 18-31-18ZM340 265v35M309 229h-24M371 229h24" />
            <circle class="mission-visual__pulse" cx="340" cy="229" r="9" />
          </g>
          <g class="mission-packages__bay mission-packages__bay--three mission-visual__float">
            <path d="m545 190 55 31v62l-55 31-55-31v-62Z" />
            <path d="m513 222 32-18 32 18v37l-32 18-32-18ZM545 277v20" />
            <circle class="mission-visual__pulse" cx="545" cy="241" r="8" />
          </g>
          <path class="mission-visual__stream" d="M190 252h82M408 241h82" />
          <g class="mission-packages__pods">
            <rect x="98" y="105" width="73" height="28" rx="10" />
            <rect x="201" y="74" width="73" height="28" rx="10" />
            <rect x="406" y="74" width="73" height="28" rx="10" />
            <rect x="509" y="105" width="73" height="28" rx="10" />
            <rect x="98" y="349" width="73" height="28" rx="10" />
            <rect x="509" y="349" width="73" height="28" rx="10" />
          </g>
        </g>
      )
    }

    {
      pageId === 'roadmap' && (
        <g class="mission-roadmap">
          <path
            class="mission-roadmap__trajectory mission-visual__stream"
            d="M78 388C142 346 168 302 211 276c61-37 96-2 145-43 43-36 63-91 111-116 40-21 78-23 137-31"
          />
          <path
            class="mission-roadmap__parallel"
            d="M207 277c44 19 62 56 107 54 46-2 76-47 111-83"
          />
          <path
            class="mission-roadmap__parallel"
            d="M207 277c40-21 57-61 99-69 38-7 79 23 119 40"
          />
          <g
            class="mission-roadmap__checkpoint mission-roadmap__checkpoint--passed"
            transform="translate(113 355)"
          >
            <circle r="27" />
            <circle class="mission-visual__pulse" r="9" />
            <path d="m-10 0 7 7 14-17" />
          </g>
          <g class="mission-roadmap__checkpoint" transform="translate(211 276)">
            <circle r="24" />
            <circle class="mission-visual__node mission-visual__node--hot" r="7" />
          </g>
          <g class="mission-roadmap__checkpoint" transform="translate(356 233)">
            <circle r="24" />
            <circle class="mission-visual__node" r="7" />
          </g>
          <g class="mission-roadmap__checkpoint" transform="translate(467 117)">
            <circle r="24" />
            <circle class="mission-visual__node" r="7" />
          </g>
          <g class="mission-roadmap__checkpoint" transform="translate(584 90)">
            <circle r="24" />
            <circle class="mission-visual__node" r="7" />
          </g>
          <g class="mission-roadmap__ticks">
            <path d="M88 393v29M187 288v32M332 244v31M443 127v32M560 99v28" />
            <path d="M75 422h64M174 320h74M319 275h74M430 159h74M547 127h74" />
          </g>
          <g
            class="mission-roadmap__craft mission-visual__float"
            transform="translate(587 86) rotate(-12)"
          >
            <path d="m0-14 26 14L0 14l6-14Z" />
