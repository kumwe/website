---
type MissionPageId =
  'platform' | 'studio' | 'extensions' | 'clients' | 'packages' | 'roadmap' | 'open-source';

interface Props {
  pageId: MissionPageId;
  class?: string;
}

const { pageId, class: className } = Astro.props;
---

<div
  class:list={['mission-visual', className]}
  data-mission={pageId}
  aria-hidden="true"
  role="presentation"
>
  <svg viewBox="0 0 680 480" preserveAspectRatio="xMidYMid meet" focusable="false">
    <rect class="mission-visual__panel" x="18" y="18" width="644" height="444" rx="34"></rect>
    <path class="mission-visual__corner" d="M51 92V54h42M629 388v38h-42"></path>
    <path
      class="mission-visual__grid"
      d="M72 125H608M72 240H608M72 355H608M170 72v336M340 72v336M510 72v336"></path>

    {
      pageId === 'platform' && (
        <g class="mission-platform">
          <g class="mission-visual__rotate mission-visual__rotate--slow">
            <ellipse class="mission-visual__orbit" cx="340" cy="242" rx="246" ry="148" />
            <circle class="mission-visual__node mission-visual__node--hot" cx="340" cy="94" r="7" />
            <circle class="mission-visual__node" cx="537" cy="153" r="6" />
            <circle class="mission-visual__node" cx="572" cy="271" r="6" />
            <circle class="mission-visual__node" cx="469" cy="370" r="6" />
            <circle class="mission-visual__node" cx="211" cy="370" r="6" />
            <circle class="mission-visual__node" cx="108" cy="271" r="6" />
            <circle class="mission-visual__node" cx="143" cy="153" r="6" />
          </g>
          <g class="mission-visual__rotate mission-visual__rotate--reverse">
