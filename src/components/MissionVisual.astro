              class="mission-clients__code"
              d="m327 198-15 15 15 15M353 198l15 15-15 15M346 190l-12 46"
            />
            <circle class="mission-visual__pulse" cx="340" cy="213" r="7" />
          </g>
          <path
            class="mission-visual__stream"
            d="M292 185 145 117M388 185l147-68M284 231 143 272M396 231l141 41"
          />
          <g class="mission-clients__device mission-clients__device--phone mission-visual__float">
            <rect x="112" y="78" width="64" height="103" rx="13" />
            <path d="M127 95h34M132 156h24" />
            <circle cx="144" cy="168" r="3" />
          </g>
          <g class="mission-clients__device mission-clients__device--tablet mission-visual__float">
            <rect x="495" y="73" width="89" height="107" rx="12" />
            <path d="M512 92h55M512 107h41M512 155h55" />
          </g>
          <g class="mission-clients__device mission-clients__device--terminal">
            <rect x="91" y="239" width="104" height="69" rx="9" />
            <path d="M113 261h58M113 276h39M131 308l-9 16M155 308l9 16M116 324h54" />
          </g>
          <g class="mission-clients__device mission-clients__device--native">
            <path d="m506 235 76 13-11 67-76-13Z" />
            <path d="m516 254 49 8M513 269l35 6M510 284l42 7" />
