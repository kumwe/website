            <rect x="507" y="181" width="56" height="10" rx="5" />
            <rect x="507" y="242" width="56" height="10" rx="5" />
            <rect x="507" y="303" width="56" height="10" rx="5" />
          </g>
          <rect class="mission-studio__scan" x="151" y="122" width="328" height="3" rx="2" />
