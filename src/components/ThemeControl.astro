---
import { defaultCatalogue } from '../i18n';

const { theme } = defaultCatalogue;
const choices = [
  { id: 'system', label: theme.system, icon: 'system' },
  { id: 'light', label: theme.light, icon: 'light' },
  { id: 'dark', label: theme.dark, icon: 'dark' },
] as const;
---

<div class="theme-control" role="group" aria-label={theme.label} data-theme-control>
  {
    choices.map((choice) => (
      <button
        class="icon-button"
        type="button"
        data-theme-choice={choice.id}
        aria-label={`${theme.label}: ${choice.label}`}
        aria-pressed="false"
        title={choice.label}
      >
        {choice.icon === 'system' && (
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M4 5.5h16v11H4zM8 20h8M12 16.5V20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        )}
        {choice.icon === 'light' && (
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="3.5" fill="none" stroke="currentColor" stroke-width="1.7" />
            <path
              d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
            />
          </svg>
        )}
        {choice.icon === 'dark' && (
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M20.3 15.4A8.5 8.5 0 0 1 8.6 3.7 8.5 8.5 0 1 0 20.3 15.4Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        )}
        <span class="theme-choice-label">{choice.label}</span>
      </button>
    ))
  }
</div>

<script>
  const THEME_KEY = 'kumwe-theme';
  const choices = ['system', 'light', 'dark'] as const;
  type ThemeChoice = (typeof choices)[number];

  const isThemeChoice = (value: string | null): value is ThemeChoice =>
    value !== null && choices.includes(value as ThemeChoice);

  function initialiseThemeControls(): void {
    const root = document.documentElement;
    const media = window.matchMedia('(prefers-color-scheme: dark)');
    const controls = document.querySelectorAll<HTMLElement>('[data-theme-control]');

    const apply = (choice: ThemeChoice, persist: boolean): void => {
      const resolved = choice === 'system' ? (media.matches ? 'dark' : 'light') : choice;
      root.dataset.themePreference = choice;
      root.dataset.theme = resolved;
      if (persist) localStorage.setItem(THEME_KEY, choice);

      for (const control of controls) {
        for (const button of control.querySelectorAll<HTMLButtonElement>('[data-theme-choice]')) {
          button.setAttribute('aria-pressed', String(button.dataset.themeChoice === choice));
        }
      }

      window.dispatchEvent(
        new CustomEvent('kumwe:theme-change', { detail: { preference: choice, theme: resolved } }),
      );
    };

    const stored = localStorage.getItem(THEME_KEY);
    const rootPreference = root.dataset.themePreference ?? null;
    const initial = isThemeChoice(stored)
      ? stored
      : isThemeChoice(rootPreference)
        ? rootPreference
        : 'system';
    apply(initial, false);

    for (const control of controls) {
      if (control.dataset.ready === 'true') continue;
      control.dataset.ready = 'true';
      control.addEventListener('click', (event) => {
        const button = (event.target as Element).closest<HTMLButtonElement>('[data-theme-choice]');
        const value = button?.dataset.themeChoice ?? null;
        if (isThemeChoice(value)) apply(value, true);
      });
    }

    if (root.dataset.themeListener !== 'true') {
      root.dataset.themeListener = 'true';
      media.addEventListener('change', () => {
        if (root.dataset.themePreference === 'system') apply('system', false);
      });
      window.addEventListener('storage', (event) => {
        if (event.key === THEME_KEY && isThemeChoice(event.newValue)) apply(event.newValue, false);
      });
    }
  }

  initialiseThemeControls();
  document.addEventListener('astro:page-load', initialiseThemeControls);
</script>

<style>
  .theme-choice-label {
    font-size: 0.68rem;
    font-weight: 630;
    line-height: 1;
  }

  :global(.theme-control .icon-button) {
    gap: 0.35rem;
    padding-inline: 0.62rem;
  }

  @media (max-width: 69.99rem) {
    .theme-choice-label {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      clip-path: inset(50%);
      white-space: nowrap;
    }

    :global(.theme-control .icon-button) {
      padding-inline: 0;
    }
  }
</style>
