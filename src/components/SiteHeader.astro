---
import { PRIMARY_NAVIGATION, UTILITY_NAVIGATION } from '../data';
import { defaultCatalogue } from '../i18n';
import BrandLogo from './BrandLogo.astro';
import LanguageControl from './LanguageControl.astro';
import ThemeControl from './ThemeControl.astro';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const { accessibility, navigation } = defaultCatalogue;
const docs = UTILITY_NAVIGATION.find((item) => item.id === 'docs');
const github = UTILITY_NAVIGATION.find((item) => item.id === 'github');
const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header" data-site-header>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${defaultCatalogue.site.title} — ${navigation.home}`}>
      <BrandLogo compact alt="" />
    </a>

    <nav
      id="primary-navigation"
      class="primary-nav"
      aria-label="Primary navigation"
      data-primary-nav
      data-open="false"
    >
      {
        PRIMARY_NAVIGATION.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {navigation[item.id]}
          </a>
        ))
      }
      {
        docs && (
          <a href={docs.href} target="_blank" rel="noreferrer">
            {navigation.docs}
            <span class="sr-only"> — {accessibility.externalLink}</span>
          </a>
        )
      }
    </nav>

    <div class="header-tools">
      <LanguageControl />
      <ThemeControl />
      {
        github && (
          <a
            class="github-button"
            href={github.href}
            target="_blank"
            rel="noreferrer"
            aria-label={`${navigation.github} — ${accessibility.externalLink}`}
          >
            <svg width="17" height="17" viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.86c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.52 2.33 1.08 2.9.83.09-.64.35-1.08.63-1.33-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.6 9.6 0 0 1 12 6.84a9.6 9.6 0 0 1 2.5.34c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"
              />
            </svg>
            <span>{navigation.github}</span>
          </a>
        )
      }
      <button
        class="menu-button"
        type="button"
        data-menu-button
        aria-expanded="false"
        aria-controls="primary-navigation"
        aria-label={accessibility.openMenu}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M4 7h16M4 12h16M4 17h16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  function initialiseHeader(): void {
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    if (!header || header.dataset.ready === 'true') return;
    header.dataset.ready = 'true';
    const button = header.querySelector<HTMLButtonElement>('[data-menu-button]');
    const nav = header.querySelector<HTMLElement>('[data-primary-nav]');
    if (!button || !nav) return;
    const close = (): void => {
      nav.dataset.open = 'false';
      button.setAttribute('aria-expanded', 'false');
    };

    button.addEventListener('click', () => {
      const open = nav.dataset.open !== 'true';
      nav.dataset.open = String(open);
      button.setAttribute('aria-expanded', String(open));
    });
    nav.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) close();
    });
    window.matchMedia('(min-width: 58.01rem)').addEventListener('change', close);
  }

  initialiseHeader();
  document.addEventListener('astro:page-load', initialiseHeader);
</script>
