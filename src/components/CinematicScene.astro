---
interface Props {
  alt: string;
  class?: string;
  lightSrc?: string;
  objectPosition?: string;
  priority?: boolean;
  src: string;
  variant?: 'hero' | 'section' | 'wide' | 'cta' | '404';
}

const {
  alt,
  class: className,
  lightSrc,
  objectPosition = '50% 50%',
  priority = false,
  src,
  variant = 'section',
} = Astro.props;
---

<div
  class:list={[
    'cinematic-scene',
    `cinematic-scene--${variant}`,
    lightSrc && 'cinematic-scene--theme-pair',
    className,
  ]}
  style={`--scene-position:${objectPosition}`}
>
  <img
    class="cinematic-scene__image cinematic-scene__image--default"
    src={src}
    alt={alt}
    loading={priority ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={priority ? 'high' : 'auto'}
  />
  {
    lightSrc && (
      <img
        class="cinematic-scene__image cinematic-scene__image--light"
        src={lightSrc}
        alt=""
        loading="lazy"
        decoding="async"
      />
    )
  }
  <span class="cinematic-scene__wash" aria-hidden="true"></span>
  <span class="cinematic-scene__edge" aria-hidden="true"></span>
</div>

<style>
  .cinematic-scene {
    --scene-position: 50% 50%;
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--mission-hairline);
    border-radius: 1.5rem;
    background: #07101e;
    isolation: isolate;
  }

  .cinematic-scene--hero {
    aspect-ratio: 17 / 12;
  }

  .cinematic-scene--section {
    aspect-ratio: 16 / 10;
  }

  .cinematic-scene--wide {
    aspect-ratio: 2 / 1;
  }

  .cinematic-scene--cta {
    min-height: 100%;
    border: 0;
    border-radius: inherit;
  }

  .cinematic-scene--404 {
    min-height: 100%;
    border: 0;
    border-radius: 0;
  }

  .cinematic-scene__image,
  .cinematic-scene__wash,
  .cinematic-scene__edge {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .cinematic-scene__image {
    object-fit: cover;
    object-position: var(--scene-position);
    transition:
      filter 260ms ease,
      opacity 260ms ease;
  }

  .cinematic-scene__image--light {
    display: none;
  }

  .cinematic-scene__wash {
    z-index: 1;
    background:
      linear-gradient(180deg, transparent 54%, rgb(1 7 18 / 35%)),
      radial-gradient(circle at 18% 12%, rgb(72 218 255 / 9%), transparent 42%);
    pointer-events: none;
  }

  .cinematic-scene__edge {
    z-index: 2;
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 4%),
      inset 0 -4rem 6rem rgb(2 7 19 / 22%);
    pointer-events: none;
  }

  :global(html[data-theme='dark']) .cinematic-scene__image--default {
    filter: saturate(0.96) contrast(1.03) brightness(0.94);
  }

  :global(html[data-theme='light'])
    .cinematic-scene:not(.cinematic-scene--theme-pair)
    .cinematic-scene__image--default {
    filter: saturate(0.88) contrast(0.94) brightness(1.1);
  }

  :global(html[data-theme='light']) .cinematic-scene--theme-pair .cinematic-scene__image--default {
    display: none;
  }

  :global(html[data-theme='light']) .cinematic-scene--theme-pair .cinematic-scene__image--light {
    display: block;
    filter: saturate(0.86) contrast(0.95) brightness(1.03);
  }

  :global(html[data-theme='light']) .cinematic-scene__wash {
    background:
      linear-gradient(180deg, rgb(237 246 251 / 3%), rgb(223 240 248 / 16%)),
      radial-gradient(circle at 18% 12%, rgb(53 220 255 / 9%), transparent 42%);
  }

  :global(html[data-theme='light']) .cinematic-scene__edge {
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 16%),
      inset 0 -3rem 5rem rgb(23 78 102 / 8%);
  }

  @media (max-width: 40rem) {
    .cinematic-scene--hero,
    .cinematic-scene--section,
    .cinematic-scene--wide {
      aspect-ratio: 4 / 3;
    }
  }
</style>
